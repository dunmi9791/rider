<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fare_evasion" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fare.evasion</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field> <!-- Adjust priority as needed -->
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Fare Evasion Monitoring" string="Fare Evasion Monitoring" data-key="fare_evasion_monitoring" groups="fare_evasion_monitoring.group_fare_evasion_manager">
                    <h2>Fare Evasion Monitoring Configuration</h2>
                    <div class="row mt16 o_settings_container" name="fare_evasion_monitoring_settings">
                        <!-- Column 1: General & Accuracy -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_fare_evasion_monitoring" invisible="1"/> <!-- Used to enable section based on group -->
                                <field name="group_fare_evasion_manager" invisible="1"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="vision_accuracy_factor"/>
                                <div class="text-muted">
                                    Adjusts raw machine vision counts (e.g., 0.65 if vision system counts 65% of actual passengers).
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="vision_accuracy_factor" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Column 2: Default Fallbacks -->
                        <div class="col-12 col-lg-6 o_setting_box">
                             <div class="o_setting_right_pane">
                                <span class="o_form_label">Fallback Values</span>
                                <div class="text-muted">
                                    Default values used if characteristics cannot be derived from transport.trip data.
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <label for="default_carded_trip_duration_seconds" class="oe_inline"/>
                                        <field name="default_carded_trip_duration_seconds" class="oe_inline"/> seconds
                                    </div>
                                    <div class="mt16">
                                        <label for="default_carded_trip_fare" class="oe_inline"/>
                                        <field name="default_carded_trip_fare" class="oe_inline"/>
                                        <!-- Assuming company currency is clear from context -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3>Spike Detection Parameters</h3>
                    <div class="row mt16 o_settings_container" name="fare_evasion_spike_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="spike_detection_window_minutes"/>
                                <div class="text-muted">
                                    "Current" period for spike analysis.
                                </div>
                                <div class="mt8">
                                    <field name="spike_detection_window_minutes" class="oe_inline"/> minutes
                                </div>

                                <label for="spike_comparison_window_hours" class="mt16"/>
                                <div class="text-muted">
                                    "Historical baseline" period.
                                </div>
                                <div class="mt8">
                                    <field name="spike_comparison_window_hours" class="oe_inline"/> hours
                                </div>

                                <label for="spike_threshold_percentage" class="mt16"/>
                                <div class="text-muted">
                                    Percentage increase to trigger a spike alert.
                                </div>
                                <div class="mt8">
                                    <field name="spike_threshold_percentage" class="oe_inline"/> %
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="min_uncarded_for_spike_alert"/>
                                <div class="text-muted">
                                    Minimum average uncarded passengers to trigger an alert.
                                </div>
                                <div class="mt8">
                                    <field name="min_uncarded_for_spike_alert" class="oe_inline"/>
                                </div>

                                <label for="min_logs_for_spike_eval" class="mt16"/>
                                <div class="text-muted">
                                    Minimum bus.log records in detection window for evaluation.
                                </div>
                                <div class="mt8">
                                    <field name="min_logs_for_spike_eval" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3>Alerting Configuration</h3>
                     <div class="row mt16 o_settings_container" name="fare_evasion_alerting_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="alert_notification_group_id"/>
                                <div class="text-muted">
                                    User group to receive Odoo notifications for spike alerts.
                                </div>
                                <div class="mt8">
                                     <field name="alert_notification_group_id" class="oe_inline" widget="many2one" options="{'no_create': True, 'no_open': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="last_spike_alert_cool_down_minutes"/>
                                <div class="text-muted">
                                    Prevents spamming alerts for the same vehicle.
                                </div>
                                <div class="mt8">
                                    <field name="last_spike_alert_cool_down_minutes" class="oe_inline"/> minutes
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
