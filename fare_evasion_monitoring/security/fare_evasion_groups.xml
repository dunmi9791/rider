<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_fare_evasion_monitoring" model="ir.module.category">
            <field name="name">Fare Evasion Monitoring</field>
            <field name="description">Helps to manage fare evasion monitoring settings and view logs.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_fare_evasion_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_fare_evasion_monitoring"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Basic user access for the Fare Evasion Monitoring module.
                Can view logs and basic dashboards.
                This group is implied by the 'Fare Evasion Monitoring' boolean in res.config.settings.
            </field>
        </record>

        <record id="group_fare_evasion_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_fare_evasion_monitoring"/>
            <field name="implied_ids" eval="[(4, ref('group_fare_evasion_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/> <!-- Admin and Root are managers by default -->
            <field name="comment">
                Manager access for the Fare Evasion Monitoring module.
                Can configure all settings, view all data, and typically receives all alert notifications if designated.
                This group is implied by the 'Fare Evasion Manager' boolean in res.config.settings.
            </field>
        </record>
    </data>
</odoo>
