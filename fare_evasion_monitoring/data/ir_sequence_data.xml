<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1"> <!-- noupdate="1" to prevent overwriting on module update -->

        <!-- Sequence for Vehicle Revenue Loss Log -->
        <record id="seq_vehicle_revenue_loss_log" model="ir.sequence">
            <field name="name">Vehicle Revenue Loss Log Sequence</field>
            <field name="code">vehicle.revenue.loss.log.sequence</field>
            <field name="prefix">VRL/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/> <!-- Shared sequence for all companies -->
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
