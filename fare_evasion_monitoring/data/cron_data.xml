<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action for Daily Revenue Loss Log Generation -->
        <record id="ir_cron_generate_daily_revenue_loss_logs" model="ir.cron">
            <field name="name">FEM: Generate Daily Revenue Loss Logs</field>
            <field name="model_id" ref="model_vehicle_revenue_loss_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_revenue_loss_logs()</field>
            <field name="user_id" ref="base.user_root"/> <!-- Run as Odoo Admin (superuser) -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field> <!-- Run indefinitely -->
            <field name="doall">False</field> <!-- Process missed calls one by one -->
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')" /> <!-- Next run at 2 AM server time -->
            <field name="active">True</field> <!-- Active by default, can be changed in UI -->
        </record>

        <!-- Scheduled Action for Revenue Loss Spike Detection & Metric Update -->
        <record id="ir_cron_check_revenue_loss_spikes" model="ir.cron">
            <field name="name">FEM: Check Revenue Loss Spikes &amp; Update Metrics</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/> <!-- Method is on fleet.vehicle -->
            <field name="state">code</field>
            <field name="code">model._cron_check_revenue_loss_spikes()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field> <!-- Run every 15 minutes -->
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <!-- nextcall will be set automatically on creation to 15 mins from now -->
            <field name="active">True</field>
        </record>

    </data>
</odoo>
